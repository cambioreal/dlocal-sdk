<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CambioReal.Dlocal</RootNamespace>
    <AssemblyName>CambioReal.Dlocal.Client</AssemblyName>
    <PackageId>CambioReal.Dlocal.Client</PackageId>
    <Description>Cliente .NET tipado para a dLocal Payins API v2.1 (payments PIX/Boleto/cartão/TED, cancelamento, payment methods, cotação de câmbio, reembolsos, chargebacks) com assinatura V2-HMAC-SHA256 e credenciais por produto (checkout/card/remittance/payout) — mesmo padrão dos SDKs cambioreal.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CambioReal.Dlocal.Client.Tests" />
  </ItemGroup>

</Project>
